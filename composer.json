{
    "name": "bakewizard/pages",
    "description": "Pages plugin for BakeKit",
    "license": "MIT",
    "type": "cakephp-plugin",
    "keywords": [
        "cakephp",
        "plugin",
        "pages",
        "static-pages",
        "bakekit"
    ],
    "require": {
        "php": ">=8.3",
        "cakephp/cakephp": "5.3.*",
        "bakewizard/bakekit": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5.3 || ^12.1.3 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Pages\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pages\\Test\\": "tests/",
            "Pages\\Test\\Fixture\\": "tests/Fixture/"
        }
    }
}
